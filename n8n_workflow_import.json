        [
          {
            "node": "Download Arquivo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Criar Pasta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar Pasta": {
      "main": [
        [
          {
            "node": "Download Arquivo",
            "type": "main",
            "index": 0
          }
        ]
      ]
