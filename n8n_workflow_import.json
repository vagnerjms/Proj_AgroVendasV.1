{
  "name": "AgroVendas to Google Drive Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agrovendas-uploads",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "id": "webhook-node-id",
      "name": "Webhook"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "advancedSearch",
        "queryString": "=name = '{{ $node[\"Webhook\"].json.body.orderNumber }} - {{ $node[\"Webhook\"].json.body.partnerName }}' and mimeType = 'application/vnd.google-apps.folder' and trashed = false and '1QKum1pz3NW3ZDo1eKyu2_08B4KDLaIro' in parents",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        200,
        240
      ],
      "id": "gdrive-find-node-id",
      "name": "Buscar Pasta",
      "alwaysOutputData": true,
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.id ? true : false }}",
              "rightValue": "",
              "operator": "isTrue"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        240
      ],
      "id": "if-node-id",
      "name": "If"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "folder",
        "name": "={{ $node[\"Webhook\"].json.body.orderNumber }} - {{ $node[\"Webhook\"].json.body.partnerName }}",
        "options": {
          "parentFolder": "1QKum1pz3NW3ZDo1eKyu2_08B4KDLaIro"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        620,
        340
      ],
      "id": "gdrive-create-node-id",
      "name": "Criar Pasta",
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $node[\"Webhook\"].json.body.downloadUrl.replace('179.197.231.106', '172.17.0.1') }}",
        "responseFormat": "file",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        820,
        240
      ],
      "id": "http-request-node-id",
      "name": "Download Arquivo"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "file",
        "operation": "upload",
        "parents": "=[ \"{{ $json.id }}\" ]",
        "binaryData": true,
        "binaryPropertyName": "data",
        "options": {
          "name": "={{ $node[\"Webhook\"].json.body.originalName }}"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1040,
        240
      ],
      "id": "gdrive-upload-node-id",
      "name": "Upload file",
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
