{
  "name": "AgroVendas to Google Drive Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agrovendas-uploads",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "id": "webhook-node-id",
      "name": "Webhook"
    },
    {
      "parameters": {
        "url": "={{ $json.body.downloadUrl }}",
        "responseFormat": "file",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        220,
        240
      ],
      "id": "http-request-node-id",
      "name": "Download Arquivo"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "list",
        "q": "=name = '{{ $('Webhook').item.json.body.orderNumber }} - {{ $('Webhook').item.json.body.partnerName }}' and mimeType = 'application/vnd.google-apps.folder' and trashed = false",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        240
      ],
      "id": "gdrive-find-node-id",
      "name": "Buscar Pasta",
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": "isNotEmpty"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        240
      ],
      "id": "if-node-id",
      "name": "Pasta Existe?"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "folder",
        "name": "={{ $('Webhook').item.json.body.orderNumber }} - {{ $('Webhook').item.json.body.partnerName }}",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        340
      ],
      "id": "gdrive-create-node-id",
      "name": "Criar Pasta",
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "file",
        "operation": "upload",
        "parents": "=[ \"{{ $json.id ? $json.id : $('Criar Pasta').item.json.id }}\" ]",
        "binaryData": true,
        "binaryPropertyName": "data",
        "options": {
          "name": "={{ $('Webhook').item.json.body.originalName }}"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1100,
        240
      ],
      "id": "gdrive-upload-node-id",
      "name": "Upload para o Google Drive",
      "credentials": {
        "googleServiceAccount": {
          "id": "",
          "name": "Google Service Account account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Download Arquivo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Arquivo": {
      "main": [
        [
          {
            "node": "Buscar Pasta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Pasta": {
      "main": [
        [
          {
            "node": "Pasta Existe?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pasta Existe?": {
      "main": [
        [
          {
            "node": "Upload para o Google Drive",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Criar Pasta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar Pasta": {
      "main": [
        [
          {
            "node": "Upload para o Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {}
}
